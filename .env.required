# =====================================================================
# VARIÁVEIS DE AMBIENTE OBRIGATÓRIAS - PORTAL MAGNAFEST
# =====================================================================
# NUNCA COMITE ESTE ARQUIVO COM VALORES REAIS!
# Copie para .env e preencha com suas credenciais
# =====================================================================

# =================================================================
# SUPABASE (OBRIGATÓRIO)
# =================================================================
# Onde obter: Dashboard Supabase → Settings → API
# Project URL: Copiar "Project URL"
# Anon Key: Copiar "anon public"

# Frontend (Vite - prefixo VITE_ é obrigatório)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Scripts Node.js (seed-magna-world.ts, seed-professionals.ts)
# ⚠️ IMPORTANTE: Use os MESMOS valores acima
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# =================================================================
# OPCIONAL: EDGE FUNCTIONS
# =================================================================
# Apenas necessário se usar automação de email/IA

# OpenAI (para geração de conteúdo)
# OPENAI_API_KEY=sk-...

# Resend (para envio de emails transacionais)
# RESEND_API_KEY=re_...

# =================================================================
# VALIDAÇÃO
# =================================================================
# Execute: npm run dev
# Se aparecer banner amarelo "Supabase não configurado", 
# significa que as variáveis não foram carregadas corretamente.
#
# Checklist:
# ✅ Arquivo .env existe na raiz do projeto
# ✅ Prefixo VITE_ nas variáveis do frontend
# ✅ Sem espaços antes/depois do =
# ✅ Valores copiados corretamente do Supabase
# ✅ Servidor reiniciado após modificar .env
#
# =================================================================
# SEGURANÇA
# =================================================================
# ❌ NUNCA comite .env ou .env.credentials no Git
# ✅ Use .env.example para versionar estrutura (sem valores reais)
# ✅ Rotacione chaves se foram expostas acidentalmente
# ✅ No Vercel/Netlify: Configure env vars no dashboard
#
# Para rotacionar chaves:
# Supabase Dashboard → Settings → API → Regenerate Keys
# =================================================================
