# =====================================================================
# CANAPEV - Configuração do Supabase
# =====================================================================
# Copie este arquivo para .env e preencha com suas credenciais
# Obtenha em: https://supabase.com/dashboard/project/[seu-projeto]/settings/api

# URL do seu projeto Supabase
VITE_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave pública (anon key) - seguro para usar no frontend
VITE_SUPABASE_ANON_KEY=sua-chave-anon-aqui

# IMPORTANTE: Nunca commite o arquivo .env no git!
